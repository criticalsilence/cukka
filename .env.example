# ==============================================================================
# CUKKA V1 — Environment Variables Template (.env.example)
# NEVER commit real private keys or API keys to Git. Copy to .env and fill in.
# ==============================================================================

# --- Chain & RPC Configuration ---
NEXT_PUBLIC_CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# --- Contract Deployment & Role Addresses (Public Addresses Only) ---
ADMIN_MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000
MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Server-Only Keys (Worker / Deployer — NEVER expose to client) ---
DEPLOYER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
MANAGER_PRIVATE_KEY=
BASESCAN_API_KEY=

# --- Privy & Paymaster (Account Abstraction) ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_CDP_PAYMASTER_URL=
NEXT_PUBLIC_PIMLICO_API_KEY=

# --- Database (Supabase Postgres — Cache & Offchain Reports Only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Aggregator APIs (0x / Odos) ---
ZEROX_API_KEY=
ODOS_API_URL=https://api.odos.xyz
